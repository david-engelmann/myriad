{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/david-engelmann/myriad/main/schemas/atlas.schema.json",
  "title": "Myriad Atlas (v1)",
  "description": "Version 1 multi-question exploration collection read by atlas, index, and changelog.",
  "type": "object",
  "required": [
    "title",
    "entries"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "label",
          "exploration"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[^\\r\\n]+$"
          },
          "exploration": {
            "$ref": "exploration.schema.json"
          }
        }
      }
    }
  }
}
